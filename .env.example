# LLM provider: gemini | anthropic | openai
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_S=60
MAX_OUTPUT_TOKENS=4000

# Website fetching
FETCH_TIMEOUT_S=10
MAX_HTML_BYTES=2000000
MAX_REDIRECTS=5
MAX_SUBPAGES=3
MAX_CONTEXT_CHARS=24000
MIN_CONTENT_CHARS=300

# Cost and abuse protection
CACHE_TTL_S=21600
RATE_LIMIT=10/minute
DAILY_BUDGET_USD=2.0
