# LLM provider: gemini | anthropic | openai
LLM_PROVIDER=gemini
# Leave empty for the provider default (gemini-3.1-flash-lite | claude-haiku-5-5 | gpt-6-luna)
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_S=60
LLM_EFFORT=low
MAX_OUTPUT_TOKENS=8000

# Website fetching
FETCH_TIMEOUT_S=10
MAX_HTML_BYTES=2000000
MAX_REDIRECTS=5
MAX_SUBPAGES=3
MAX_CONTEXT_CHARS=24000
MIN_CONTENT_CHARS=300

# Cost and abuse protection
CACHE_TTL_S=21600
RATE_LIMIT=10/minute
# true only behind a proxy that appends the client IP to X-Forwarded-For (e.g. Render)
TRUST_PROXY_HEADERS=false
DAILY_BUDGET_USD=2.0
